{
  "$schema": "https://developer.dynatrace.com/docs-assets/schema_strict_apps.json",
  "dynatrace": "1",
  "schemaId": "segment-config",
  "version": "0.0.1",
  "summaryPattern": "{name}",
  "displayName": "Segment Configuration",
  "description": "Saves a named segment filter for session analytics",
  "multiObject": true,
  "maxObjects": 100,
  "ordered": false,
  "ownerBasedAccessControl": true,
  "properties": {
    "name": {
      "displayName": "Segment Name",
      "description": "Human-readable name for this segment",
      "type": "text",
      "nullable": false,
      "constraints": [
        {
          "type": "LENGTH",
          "maxLength": 100,
          "minLength": 1
        }
      ],
      "default": ""
    },
    "hasErrors": {
      "displayName": "Has Errors",
      "description": "Filter to sessions with errors",
      "type": "boolean",
      "default": false
    },
    "isBounced": {
      "displayName": "Is Bounced",
      "description": "Filter to bounced sessions (1 page or less)",
      "type": "boolean",
      "default": false
    },
    "hasReplay": {
      "displayName": "Has Replay",
      "description": "Filter to sessions with session replay available",
      "type": "boolean",
      "default": false
    },
    "country": {
      "displayName": "Country",
      "description": "ISO-2 country code filter (e.g. US, GB, DE)",
      "type": "text",
      "nullable": true
    },
    "browser": {
      "displayName": "Browser",
      "description": "Browser name filter (e.g. Chrome, Firefox)",
      "type": "text",
      "nullable": true
    },
    "os": {
      "displayName": "Operating System",
      "description": "OS name filter (e.g. Windows, macOS)",
      "type": "text",
      "nullable": true
    },
    "url": {
      "displayName": "URL Value",
      "description": "URL filter value",
      "type": "text",
      "nullable": true
    },
    "urlOp": {
      "displayName": "URL Operator",
      "description": "URL match operator",
      "type": "text",
      "nullable": true,
      "constraints": [
        {
          "type": "LENGTH",
          "maxLength": 20
        }
      ]
    },
    "urlField": {
      "displayName": "URL Field",
      "description": "Which part of the URL to match against",
      "type": "text",
      "nullable": true,
      "constraints": [
        {
          "type": "LENGTH",
          "maxLength": 20
        }
      ]
    }
  }
}
