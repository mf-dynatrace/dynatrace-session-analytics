{
  "$schema": "https://developer.dynatrace.com/docs-assets/schema_strict_apps.json",
  "dynatrace": "1",
  "schemaId": "segment-config",
  "version": "0.0.2",
  "summaryPattern": "{name}",
  "displayName": "Saved Segments",
  "description": "Named audience segments for filtering Session Analytics. Each segment compiles to a DQL filter clause applied globally.",
  "multiObject": true,
  "maxObjects": 50,
  "ordered": false,
  "ownerBasedAccessControl": false,
  "properties": {
    "name": {
      "displayName": "Segment Name",
      "description": "A short descriptive label (e.g. 'Italian mobile users')",
      "type": "text",
      "nullable": false,
      "constraints": [
        { "type": "LENGTH", "maxLength": 80, "minLength": 1 }
      ],
      "default": ""
    },
    "hasErrors": {
      "displayName": "Sessions with errors only",
      "type": "boolean",
      "nullable": false,
      "default": false
    },
    "isBounced": {
      "displayName": "Bounced sessions only",
      "type": "boolean",
      "nullable": false,
      "default": false
    },
    "hasReplay": {
      "displayName": "Sessions with replay only",
      "type": "boolean",
      "nullable": false,
      "default": false
    },
    "country": {
      "displayName": "Country ISO code",
      "description": "2-letter ISO code, e.g. IT, US, DE. Leave empty to ignore.",
      "type": "text",
      "nullable": false,
      "constraints": [
        { "type": "LENGTH", "maxLength": 10, "minLength": 0 }
      ],
      "default": ""
    },
    "browser": {
      "displayName": "Browser name (contains)",
      "description": "e.g. Chrome, Firefox, Safari. Leave empty to ignore.",
      "type": "text",
      "nullable": false,
      "constraints": [
        { "type": "LENGTH", "maxLength": 50, "minLength": 0 }
      ],
      "default": ""
    },
    "os": {
      "displayName": "OS name (contains)",
      "description": "e.g. Windows, macOS, Android. Leave empty to ignore.",
      "type": "text",
      "nullable": false,
      "constraints": [
        { "type": "LENGTH", "maxLength": 50, "minLength": 0 }
      ],
      "default": ""
    },
    "url": {
      "displayName": "URL value",
      "description": "Value to match against the URL field selected in urlField. Leave empty to ignore.",
      "type": "text",
      "nullable": false,
      "constraints": [
        { "type": "LENGTH", "maxLength": 200, "minLength": 0 }
      ],
      "default": ""
    },
    "urlOp": {
      "displayName": "URL operator",
      "description": "How to match: contains | not_contains | equals",
      "type": "text",
      "nullable": false,
      "constraints": [
        { "type": "LENGTH", "maxLength": 20, "minLength": 0 }
      ],
      "default": "contains"
    },
    "urlField": {
      "displayName": "URL field",
      "description": "Which URL part to filter: path | domain | full",
      "type": "text",
      "nullable": false,
      "constraints": [
        { "type": "LENGTH", "maxLength": 10, "minLength": 0 }
      ],
      "default": "path"
    }
  }
}
